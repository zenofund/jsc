# =====================================================
# APPLICATION
# =====================================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# =====================================================
# DATABASE (NEON POSTGRES)
# =====================================================
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# =====================================================
# JWT AUTHENTICATION
# =====================================================
JWT_SECRET=your-secret-key
JWT_EXPIRATION=24h

# =====================================================
# CORS
# =====================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =====================================================
# WEB PUSH NOTIFICATIONS
# Generate a matching public/private pair with: npx web-push generate-vapid-keys
# The public key is returned to authenticated clients by the API.
# =====================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@jsc.gov.ng

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=log

# =====================================================
# SECURITY
# =====================================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
ENABLE_REQUEST_LOGGING=true
